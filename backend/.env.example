# 复制为 .env 并填写。真实密钥只在本机，绝不提交。
DEEPSEEK_API_KEY=
# DeepSeek 官方地址；换 provider 只改这里和模型名
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 模型调用内部超时（秒），总响应须 < 客户端 20 秒超时
TUTOR_MODEL_TIMEOUT_SECONDS=10
# 服务绑定（与朱玉同机联调）
TUTOR_HOST=127.0.0.1
TUTOR_PORT=8000
# JSONL 日志目录（相对 backend/，运行时自动创建）
TUTOR_LOG_DIR=logs
# 语音朗读（微软 edge-tts，免费无密钥；失败时客户端自动降级为纯文本）
TTS_ENABLED=true
# 微软神经语音名，如女声 zh-CN-XiaoxiaoNeural、男声 zh-CN-YunxiNeural
TTS_VOICE=zh-CN-YunxiNeural
# 单次合成文本上限（字符），与接口 schema 一致
TTS_MAX_CHARS=500
